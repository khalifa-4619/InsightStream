# =======================================================================
# STAGE 1: DEPENDENCY RESOLVER (Builder Stage)
# We separate dependency installations from the final runtime image.
# This keeps the final image (lean) (no compilers, no dev headers).
# ======================================================================
FROM python:3.12-slim AS Builder

# prevents python from writing .pyc files and buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install system packages needed to compile python libraries (like psycopg2)
# --no-install-recommends skips optional packages, saving space.
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Create a virtual environment to isolate our dependencies
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"


# Copy only requirements first - this leverages Docker's build cache.
# If requirements.txt doesn't change, the pip install layer is reused.
WORKDIR /app
COPY backend/requirements.txt .

# Install dependencies into the virtual environment
RUN pip install --no-cache-dir -r requirements.txt

# =============================================================================
# STAGE 2: RUNTIME IMAGE (Production)
# Start from the same slim base, but only copy what's needed.
# =============================================================================
FROM python:3.12-slim AS runtime

# Set the same environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install only runtime system dependencies (libpq is needed for psycopg2)
RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Create a non-root user for security.
# Containers should NEVER run as root unless absolutely necessary.
RUN addgroup --system app && adduser --system --group app

# Copy the virtual environment from the builder stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set the working directory
WORKDIR /app

# Copy the application code
COPY backend/ .

# Ensure the uploads directory exists and is writable by the app user
RUN mkdir -p /app/uploads && chown -R app:app /app

# Copy the entrypoint script (we'll create this next)
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Switch to non-root user
USER app

# Expose the port the app runs on (FastAPI default)
EXPOSE 8000

# The entrypoint script handles waiting for the database and running migrations,
# then starts the uvicorn server
ENTRYPOINT [ "/docker-entrypoint.sh" ]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]